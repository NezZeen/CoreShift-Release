# The CoreShift daemon: proxy cores, the TUN interface and DNS protection.
#
# It runs as root from boot, so the app runs without privileges and talks
# to it over 127.0.0.1 with the token in /var/lib/coreshift/api.json, which
# only members of the coreshift group may read. The VPN stays up until the
# user turns it off, also with the app closed.
#
# A template: @BINDIR@ and @LIBDIR@ are filled in by build.sh (/usr/bin,
# /usr/lib/coreshift for the packages) or install.sh (/usr/local/...).
# See packaging/linux/README.md.

[Unit]
Description=CoreShift VPN daemon
Documentation=https://github.com/NezZeen/CoreShift-Release
After=network.target firewalld.service
Wants=network.target

[Service]
Type=simple
# A crash, a power cut or a kill can leave the system's DNS pointing at a
# tunnel that is gone. Undo that before anything else: at boot, and before
# each restart. The daemon does it again itself, so a failure here is not
# fatal ("-").
# The data folder must be there for ReadWritePaths below: the package makes
# it, but users remove it to forget their settings. "+": outside the
# sandbox, where /var/lib is writable; the daemon then sets its owner and
# mode (SecureDataDir).
ExecStartPre=+mkdir -p -m 0700 /var/lib/coreshift
ExecStartPre=-@BINDIR@/coreshiftd dns recover -journal /var/lib/coreshift/dnsguard.json
ExecStart=@BINDIR@/coreshiftd service run -data-dir /var/lib/coreshift -cores-dir @LIBDIR@/cores
Restart=on-failure
RestartSec=2
# SIGTERM disconnects and restores DNS; the cores and the TUN layer die
# with the daemon (Pdeathsig), and anything left is killed after the
# timeout.
KillMode=mixed
TimeoutStopSec=20
UMask=0077

# Hardening, as far as the daemon, the cores, the TUN layer and the DNS
# tools it runs (resolvectl, resolvconf, netconfig, nmcli, firewall-cmd,
# restorecon) still work; they all run within it. Checked with
# systemd-analyze security and in WSL (packaging/linux/README.md).
#
# Capabilities: NET_ADMIN for the TUN, routes and rules and for
# systemd-resolved's per-link DNS; NET_RAW for binding sockets to the
# physical interface (SO_BINDTODEVICE) and for ping; SYS_PTRACE and
# DAC_READ_SEARCH to read other users' /proc/<pid>/exe and fd for per-app
# routing; CHOWN and FOWNER to hand the data folder and api.json to the
# coreshift group and take foreign files back (SecureDataDir). Root owns
# every file the daemon writes, so DAC_OVERRIDE is not needed, nor KILL:
# it signals only its own children. Ports below 1024 are never bound.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
NoNewPrivileges=yes
# Everything read-only, but for the data, the cores (they update
# themselves) and what the DNS guard changes: /etc/resolv.conf, replaced
# atomically, so all of /etc, and the state of resolvconf and netconfig,
# where those are in use. sing-box sets rp_filter on its interface.
ProtectSystem=strict
ReadWritePaths=/var/lib/coreshift @LIBDIR@/cores /etc -/run/resolvconf -/run/netconfig -/var/adm/netconfig
ReadWritePaths=/proc/sys/net/ipv4/conf
ProtectHome=read-only
PrivateTmp=yes
# Of the devices, only the TUN.
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# Go needs no writable code, and neither do firewall-cmd (Python) or the
# other DNS tools.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
